# At least one provider key is required to run an agent.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
XAI_API_KEY=xai-...

# Optional defaults (AGENT.md can override provider and model)
# AGENTGW_LLM_PROVIDER=openai
# AGENTGW_LLM_MODEL=gpt-4o-mini

# Channel bots (optional). When set, `agentgw serve` attaches Discord/Telegram
# to the same session store as REST/CLI. Or run `agentgw discord` / `telegram`
# with AGENTGW_URL pointing at the daemon.
# DISCORD_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=

# Outbound notify tool (optional). Any combination of:
# NOTIFY_WEBHOOK_URL=https://example.com/hooks/agentgw
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# NOTIFY_CHAT_ID=   # Telegram chat; uses TELEGRAM_BOT_TOKEN above

# REST daemon auth (optional). When set, /v1/* requires Authorization: Bearer <key>.
# /health stays public. Required before binding 0.0.0.0 or exposing a Pi.
# AGENTGW_API_KEY=
